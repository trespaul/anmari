---
import { getCollection } from "astro:content";
import Page from "@/layouts/Page.astro";
import FormattedDate from "@/components/FormattedDate.astro";

type Category = {
  category: string,
  title: string,
  filter: (types: string[]) => boolean,
};

export function getStaticPaths() {
  const categories : Category[] = [
    { category: "calendar",
      title: "Calendar",
      filter: types => types.includes("event"),
    },
    { category: "videos",
      title: "Videos",
      filter: types => types.includes("video"),
    },
    { category: "music",
      title: "Music",
      filter: types => types.includes("music"),
    },
    //{ category: "photos",   description: "Photo updates.", },
  ];
  return categories.map( item => ({
    params: { category: item.category },
    props: item,
  }));
}

const { title, filter } = Astro.props;
const posts = await getCollection("updates");
const categoryPosts = posts
  .filter(post => filter(post.data.type))
  .sort( (a, b) => (new Date(b.data.start)).getTime() - (new Date(a.data.start)).getTime() );
---

<Page
  title={title}
>
  <ol id="list" class="list-none ml-0">
    { categoryPosts.map(async post => {
        const { id, data: {title, start, end, place, description} } = post;
        return (
          <a href={`/post/${id}`}>
            <li class="mb-4">
              <ul class="list-none ml-0 pb-4">
                <li class="opacity-70">
                  <FormattedDate
                    start={new Date(start)}
                    end={end ? new Date(end) : undefined}
                  />
                </li>
                <li class="text-balance">{title}</li>
                { description &&
                    <li class="text-balance opacity-70">{description}</li>
                }
                { place &&
                    <li class="text-balance italic opacity-70">{place}</li>
                }
              </ul>
            </li>
          </a>
        )
      })
    }
  </ol>
</Page>
