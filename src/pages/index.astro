---
import Base from "@/components/Base.astro";
import { metadata } from "@/metadata.ts";
import Footer from "@/components/Footer.astro";
import NextUp from "@/components/NextUp.tsx";
import { getCollection } from "astro:content";

const posts = await getCollection("updates");
const sortedPosts = posts.sort((a, b) =>
  a.data.start.getTime() - b.data.start.getTime()
);
---

<Base title={metadata.title} description={metadata.description} header={false} footer={false}>
  <section
    id="hero"
    class="min-h-svh py-4 flex flex-col"
  >
    <div
      class="text-[min(24vw,27vh)]/[min(18vw,20vh)]!
        font-thin tracking-tighter wrap-break-word grow"
      style="font-variation-settings: 'opsz' 144, 'WONK' 0;"
    >
      <h1 class="text-balance" set:html={
        `${metadata.htmlTitle ?? metadata.title},`
      } />
      <p class="italic text-right mr-[5vw]">{metadata.tagline}</p>
    </div>
    <div class="flex flex-row items-end gap-x-8">
      <p class="grow text-balance">
        <NextUp client:only="solid" />
      </p>
      <a href="#more" class="smallcaps"><span>more</span>&nbsp;↓</a>
    </div>
  </section>

  <section
    id="more"
    class="min-h-lvh pt-4 flex flex-col"
  >
    <div class="grow grid grid-cols-1 md:grid-cols-2 gap-4
      items-start place-content-start"
    >
      <p class="text-balance">{metadata.description}</p>

      <div class="col-span-2 md:grid grid-cols-subgrid">
        <nav class="col-start-2 flex flex-col">
          <ul>
            <li><a href="/about" class="smallcaps">about</a></li>
            <li><a href="/catalogue" class="smallcaps">catalogue</a></li>
            <li><a href="/photos" class="smallcaps">photos</a></li>
            <li>
              <a href="/updates" class="smallcaps">updates</a>
              <ul class="ml-4">
                <li><a href="/calendar" class="smallcaps">calendar</a></li>
                <li><a href="/music" class="smallcaps">music</a></li>
                <li><a href="/videos" class="smallcaps">videos</a></li>
              </ul>
            </li>
            <li><a href="/contact" class="smallcaps">contact</a></li>
          </ul>
        </nav>
      </div>
    </div>
    <Footer />
  </section>
</Base>
