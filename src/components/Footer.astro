---
import { metadata } from "@/metadata.ts";

const today = new Date();
---

<footer class="text-base py-4 md:grid grid-cols-1 gap-x-4 md:grid-cols-2">
  <span>&copy; {today.getFullYear()} {metadata.author}. All rights reserved.</span>
  <span>Website by <a href={metadata.siteBy.url}>{metadata.siteBy.name}</a>.</span>
</footer>
