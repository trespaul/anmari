---
import { Image } from "astro:assets";

const { images } = Astro.props;
---

<section
  class="gallery mb-8 mt-24 gap-4 columns-1 md:columns-2 lg:columns-3"
>
  { images.map( ({ file, alt }: { file: ImageMetadata, alt: string }) =>
      <Image
        class="gallery-item mb-4"
        src={file}
        alt={alt}
      />
    )
  }
</section>
