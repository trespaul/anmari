---
import Base from "@/components/Base.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import Gallery from "@/components/Gallery.astro";

const {
  title,
  subtitle,
  description,
  images,
  start,
  end,
} = Astro.props;
---

<Base title={title} description={description}>
  <article
    class="text-3xl my-8
      grid grid-cols-1 gap-x-4 gap-y-16 items-start
      xl:grid-cols-2"
  >
    {/* Page title and metadata */}
    <section>
      <h1 class="text-balance">{title}</h1>
      { subtitle &&
          <p class="mb-0! text-2xl text-left! text-balance">{subtitle}</p>
      }
      { start &&
          <p class="mb-0! text-2xl">
            <FormattedDate
              start={new Date(start)}
              end={end ? new Date(end) : undefined}
            />
          </p>
      }
      { description &&
          <p class="mb-0! text-2xl text-left! text-balance italic">{description}</p>
      }
      {/* ToC here */}
    </section>
    <section class="prose text-xl md:text-3xl">
      <slot />
    </section>
  </article>
  { images && <Gallery images={images} /> }
</Base>
